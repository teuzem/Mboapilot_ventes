# Environnement
MBOA_ENV=development
MBOA_PORT=5000
MBOA_DEBUG=0
MBOA_SECRET=
MBOA_DEMO=1
MBOA_COOKIE_SECURE=0
MBOA_SESSION_MINUTES=30
MBOA_SESSION_MAX_HOURS=8

# Authentification forte
MBOA_MFA=1
MBOA_MFA_KEY=
MBOA_RECOVERY_PEPPER=
MBOA_RP_ID=localhost
MBOA_ORIGIN=http://localhost:5000
MBOA_STEP_UP_MINUTES=5

# Email (Resend par défaut, smtp pour Brevo)
MBOA_MAIL_PROVIDER=resend
RESEND_API_KEY=
MBOA_MAIL_FROM=onboarding@resend.dev
MBOA_MAIL_FROM_NAME=MboaPilot
MBOA_ADMIN_EMAILS=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Web Push VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mboapilot.cm

# SMS (alertes de criticité haute)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SID=
MBOA_SMS_ADMIN=

# Alertes et rapports
MBOA_ALERTE_ANTI_REBOND=60
MBOA_RAPPORT_HEURE=7

# Connecteurs ETL
MBOA_RESEAU_TIMEOUT=15
MBOA_USER_AGENT=MboaPilot-ETL/1.0
MBOA_RETRY=3
